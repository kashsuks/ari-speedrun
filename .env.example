# Full Cookie header copied from your browser while logged into https://ari.hackclub.com
# (DevTools → Network → any ari.hackclub.com request → Request Headers → cookie)
ARI_COOKIE=

# Anthropic API key used for README / demo / commit analysis
ANTHROPIC_API_KEY=

# Optional: GitHub token (no scopes needed) to raise the GitHub API rate limit from 60/h to 5000/h
GITHUB_TOKEN=

# Password that protects the dashboard. REQUIRED when hosted anywhere public,
# because the app holds your Ari session and can submit decisions.
APP_PASSWORD=

PORT=8787
