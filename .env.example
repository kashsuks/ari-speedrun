# Full Cookie header copied from your browser while logged into https://ari.hackclub.com
# (DevTools → Network → any ari.hackclub.com request → Request Headers → cookie)
ARI_COOKIE=

# Which AI reviews each ship:
#   api          Anthropic API, needs ANTHROPIC_API_KEY (default when the key is set)
#   claude-code  your logged-in `claude` CLI / Claude subscription (default otherwise)
#   codex        your logged-in `codex` CLI / ChatGPT subscription
AI_PROVIDER=
# Optional model override. Defaults: api=claude-opus-5-5, claude-code=haiku, codex=gpt-5.6-luna
AI_MODEL=

# Anthropic API key, only needed for AI_PROVIDER=api
ANTHROPIC_API_KEY=

# Optional: GitHub token (no scopes needed) to raise the GitHub API rate limit from 60/h to 5000/h
GITHUB_TOKEN=

# Password that protects the dashboard. REQUIRED when hosted anywhere public,
# because the app holds your Ari session and can submit decisions.
APP_PASSWORD=

PORT=8787
